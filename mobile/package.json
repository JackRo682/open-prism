{
  "name": "getopenprism-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "start:dev": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "check:expo": "expo install --check",
    "export": "expo export --platform all",
    "verify": "npm run typecheck && npm run check:expo && npm run export"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "expo": "58.0.26",
    "expo-dev-client": "58.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "6.0.3"
  }
}
