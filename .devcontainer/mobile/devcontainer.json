{
  "name": "GetOpenPrism mobile",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/mobile",
  "postCreateCommand": "npm ci",
  "forwardPorts": [
    8081
  ],
  "portsAttributes": {
    "8081": {
      "label": "Expo preview",
      "onAutoForward": "notify"
    }
  }
}
